[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/instructions_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/menu_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
content_margin_left = 40.0
content_margin_top = 32.0
content_margin_right = 40.0
content_margin_bottom = 32.0
bg_color = Color(0.0784314, 0.152941, 0.109804, 0.95)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.360784, 0.6, 0.309804, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="InstructionsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0627451, 0.129412, 0.0941176, 1)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -200.0
offset_right = 300.0
offset_bottom = 200.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("PanelStyle")

[node name="Content" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="TitleLabel" type="Label" parent="Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "INSTRUCCIONES"
horizontal_alignment = 1

[node name="ControlsLabel" type="Label" parent="Panel/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/line_spacing = 10
text = "A / Flecha izquierda  -  Moverse a la izquierda
D / Flecha derecha  -  Moverse a la derecha
W / Espacio  -  Saltar
Shift  -  Dash
Click izquierdo  -  Atacar
ESC  -  Pausa"
horizontal_alignment = 1
vertical_alignment = 1

[node name="BackButton" type="Button" parent="Panel/Content"]
custom_minimum_size = Vector2(0, 62)
layout_mode = 2
text = "VOLVER"

[connection signal="pressed" from="Panel/Content/BackButton" to="." method="_on_back_button_pressed"]
