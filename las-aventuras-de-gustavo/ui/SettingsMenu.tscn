[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://ui/menu_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://ui/settings_menu.gd" id="2_script"]

[node name="SettingsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.0431373, 0.0745098, 0.0784314, 1)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -180.0
offset_right = 300.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2

[node name="Options" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Panel/Options"]
layout_mode = 2
theme_override_colors/font_color = Color(0.976471, 0.792157, 0.337255, 1)
theme_override_font_sizes/font_size = 40
text = "CONFIGURACIÓN"
horizontal_alignment = 1

[node name="VolumeRow" type="HBoxContainer" parent="Panel/Options"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="VolumeLabel" type="Label" parent="Panel/Options/VolumeRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Volumen"

[node name="VolumeSlider" type="HSlider" parent="Panel/Options/VolumeRow"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 1.0
step = 0.05
value = 1.0

[node name="FullscreenCheck" type="CheckButton" parent="Panel/Options"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Pantalla completa"

[node name="BackButton" type="Button" parent="Panel/Options"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
text = "VOLVER"

[connection signal="value_changed" from="Panel/Options/VolumeRow/VolumeSlider" to="." method="_on_volume_slider_value_changed"]
[connection signal="toggled" from="Panel/Options/FullscreenCheck" to="." method="_on_fullscreen_check_toggled"]
[connection signal="pressed" from="Panel/Options/BackButton" to="." method="_on_back_button_pressed"]
